  ],
  "keywords": [
    "vitepress",
    "navbar",
    "hud",
    "git",
    "version"
  ],
  "peerDependencies": {
    "vitepress": "^1.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {}
}
